{
  "name": "drift-luxury-sarees",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 execute drift-commerce-db --local --file=./db/schema.sql",
    "db:migrate:prod": "wrangler d1 execute drift-commerce-db --remote --file=./db/schema.sql",
    "db:seed": "npx tsx db/seed.ts",
    "r2:sync": "npx tsx scripts/upload-r2.ts",
    "pages:build": "npx @opennextjs/cloudflare build",
    "pages:deploy": "npm run pages:build && wrangler deploy"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/three": "^0.169.0",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "gsap": "^3.12.5",
    "hono": "^4.13.18",
    "lenis": "^1.3.27",
    "lucide-react": "^0.453.0",
    "next": "^15.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.169.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@opennextjs/cloudflare": "^1.20.17",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
